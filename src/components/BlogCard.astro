---
import ArrowLink from "./ArrowLink.astro";
import type { PostEntry } from "../data/site-content";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { slug } = post;
---

<article
  class="max-w-[440px] object-fill flex flex-col gap-2 sm:gap-9"
  data-category={post.category}
>
  <a class="relative w-full overflow-hidden" href={`/journal/${slug}/`}>
    <img
      class="w-full h-auto object-cover transition-transform duration-500 media-monochrome hover:scale-[1.02]"
      src={post.cover.src}
      alt={post.coverAlt}
      width={440}
      loading="lazy"
    />
  </a>
  <div class="flex flex-col gap-3">
    <p class="text-sm uppercase tracking-[0.3em] text-gold-100">
      {post.category}
    </p>
    <h2 class="font-black text-lg">
      <a href={`/journal/${slug}/`}>{post.title}</a>
    </h2>
    <p class="text-sm leading-relaxed">{post.excerpt}</p>
  </div>
  <div class="flex gap-8 items-center">
    <div class="bg-black flex-grow h-[1px]"></div>
    <ArrowLink href={`/journal/${slug}/`} label="READ" />
  </div>
</article>
