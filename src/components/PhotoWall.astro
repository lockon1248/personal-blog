---
import type { PhotoEntry } from "../data/site-content";

interface Props {
  photos: PhotoEntry[];
}

const { photos } = Astro.props;
---

<div class="grid [grid-template-columns:repeat(auto-fit,minmax(140px,1fr))] gap-4 w-full pb-5">
  {
    photos.map((photo) => (
      <figure data-category={photo.category} class="space-y-3">
        <img
          class="w-full aspect-square object-cover media-monochrome"
          src={photo.image.src}
          alt={photo.alt}
          width={420}
          loading="lazy"
        />
        <figcaption>
          <h2 class="font-semibold">{photo.title}</h2>
          <p class="text-sm text-slate-700">{photo.location}</p>
        </figcaption>
      </figure>
    ))
  }
</div>
