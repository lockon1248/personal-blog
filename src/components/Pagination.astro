---
import ArrowLink from "./ArrowLink.astro";

interface LinkItem {
  href: string;
  title: string;
}

interface Props {
  prev?: LinkItem;
  next?: LinkItem;
  indexHref: string;
  indexLabel: string;
}

const { prev, next, indexHref, indexLabel } = Astro.props;
---

<nav class="h-[150px] flex" aria-label="文章分頁">
  <div class="flex items-center justify-around w-full gap-6 flex-wrap">
    <ArrowLink
      href={prev?.href}
      direction="prev"
      label={prev ? `PREV ${prev.title}` : "PREV"}
    />
    <div class="flex flex-col group cursor-pointer">
      <a href={indexHref}>
        <p>{indexLabel}</p>
      </a>
      <div class="h-[3px] w-full bg-gold-100 transition-all duration-500 ease-in-out group-hover:w-[120%] group-hover:ml-[-10%]"></div>
    </div>
    <ArrowLink
      href={next?.href}
      direction="next"
      label={next ? `NEXT ${next.title}` : "NEXT"}
    />
  </div>
</nav>
