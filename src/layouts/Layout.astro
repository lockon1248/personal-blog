---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import logo from "../icons/logo.svg";
const {
  title,
  description = "Lockon 賴世原｜前端工程師，個人作品集、攝影紀錄、旅拍影像與影像創作。",
  canonical,
  ogImage,
  noindex = false,
  schema,
} = Astro.props;
const schemaJson = schema ? JSON.stringify(schema) : null;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    {schemaJson && (
      <script is:inline type="application/ld+json" set:html={schemaJson} />
    )}
  </head>
  <body class="bg-custom-beige">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    box-sizing: border-box;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }
</style>
