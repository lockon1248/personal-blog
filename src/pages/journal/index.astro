---
import BlogCard from "../../components/BlogCard.astro";
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/site-content";

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.publishDate).valueOf() - new Date(a.publishDate).valueOf()
);

const categories = [
  { value: "all", label: "All" },
  { value: "travel", label: "Travel" },
  { value: "city", label: "City" },
  { value: "reflection", label: "Reflection" },
];

const seo = {
  title: "旅遊日誌｜Lockon 賴世原",
  description:
    "閱讀 Lockon 賴世原的旅遊日誌與影像故事，記錄旅行中的城市觀察與生活片段。",
  canonical: new URL("/journal", Astro.site).toString(),
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: "旅遊日誌",
      url: seo.canonical,
      description: seo.description,
      inLanguage: "zh-Hant",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "首頁", item: Astro.site?.toString() },
        { "@type": "ListItem", position: 2, name: "旅遊日誌", item: seo.canonical },
      ],
    },
  ],
};
---

<Layout {...seo} schema={schema}>
  <main class="p-8 sm:px-[103px] sm:py-0">
    <div class="flex justify-between h-full gap-8">
      <nav class="md:min-w-[161px] flex flex-col gap-3" aria-label="文章分類">
        {
          categories.map((item, index) => (
            <button
              class="text-left section-filter-link"
              type="button"
              data-filter-trigger
              data-filter-value={item.value}
              data-default={index === 0 ? "true" : undefined}
            >
              {item.label}
            </button>
          ))
        }
      </nav>
      <section class="flex gap-[40px] flex-wrap overflow-auto scroll pb-5 justify-center h-[calc(100vh-130px-148px)] flex-1">
        {sortedPosts.map((post) => <BlogCard post={post} />)}
      </section>
      <div>
        <h1 class="section-outline-label hidden md:flex">JOURNAL</h1>
      </div>
    </div>
  </main>
</Layout>

<script>
  const initFilters = (scope: Document) => {
    const triggers = scope.querySelectorAll<HTMLElement>("[data-filter-trigger]");
    const cards = scope.querySelectorAll<HTMLElement>("article[data-category]");
    if (!triggers.length || !cards.length) return;

    const applyFilter = (value: string) => {
      cards.forEach((card) => {
        const shouldShow =
          value === "all" || card.dataset.category === value;
        card.classList.toggle("hidden", !shouldShow);
      });
      triggers.forEach((trigger) => {
        trigger.dataset.active = String(trigger.dataset.filterValue === value);
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        applyFilter(trigger.dataset.filterValue ?? "all");
      });
    });

    const defaultTrigger = Array.from(triggers).find((trigger) => trigger.dataset.default === "true");
    applyFilter(defaultTrigger?.dataset.filterValue ?? "all");
  };

  initFilters(document);
</script>

<style is:inline>
  .scroll::-webkit-scrollbar-track {
    background-color: #f1ece0;
  }
  .scroll::-webkit-scrollbar {
    width: 6px;
    background-color: #f1ece0;
  }
  .scroll::-webkit-scrollbar-thumb {
    background-color: #d9bb73;
    border-radius: 20px;
  }
</style>
