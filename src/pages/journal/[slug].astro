---
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { posts } from "../../data/site-content";

export async function getStaticPaths() {
  const sortedPosts = [...posts].sort(
    (a, b) => new Date(a.publishDate).valueOf() - new Date(b.publishDate).valueOf()
  );

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: sortedPosts[index - 1],
      next: sortedPosts[index + 1],
    },
  }));
}

const { post, prev, next } = Astro.props;

const canonical = new URL(`/journal/${post.slug}/`, Astro.site).toString();
const seo = {
  title: post.seoTitle ?? `${post.title}｜Lockon 賴世原`,
  description: post.seoDescription ?? post.excerpt,
  canonical,
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.title,
      description: seo.description,
      url: canonical,
      mainEntityOfPage: canonical,
      image: [new URL("/avatar.png", Astro.site).toString()],
      author: {
        "@type": "Person",
        name: "賴世原",
        alternateName: "Lockon",
      },
      publisher: {
        "@type": "Person",
        name: "賴世原",
        alternateName: "Lockon",
      },
      datePublished: new Date(post.publishDate).toISOString(),
      inLanguage: "zh-Hant",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "首頁", item: Astro.site?.toString() },
        { "@type": "ListItem", position: 2, name: "旅遊日誌", item: new URL("/journal", Astro.site).toString() },
        { "@type": "ListItem", position: 3, name: post.title, item: canonical },
      ],
    },
  ],
};
---

<Layout {...seo} schema={schema}>
  <main>
    <div class="mx-auto">
      <img
        class="object-cover w-full max-h-[70vh]"
        src={post.cover.src}
        alt={post.coverAlt}
        width={1400}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <article class="max-w-4xl mx-auto p-8 flex flex-col gap-10">
      <header class="space-y-4">
        <p class="text-sm uppercase tracking-[0.3em] text-gold-100">
          {post.category}
        </p>
        <h1 class="text-3xl font-bold text-center">{post.title}</h1>
        <p class="text-center text-slate-600">
          {new Date(post.publishDate).toLocaleDateString("zh-TW")}
        </p>
      </header>
      <div class="rich-text" set:html={post.content}></div>
    </article>
    <Pagination
      prev={prev ? { href: `/journal/${prev.slug}/`, title: prev.title } : undefined}
      next={next ? { href: `/journal/${next.slug}/`, title: next.title } : undefined}
      indexHref="/journal"
      indexLabel="JOURNAL"
    />
  </main>
</Layout>
