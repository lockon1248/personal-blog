---
import Layout from "../layouts/Layout.astro";
import PhotoWall from "../components/PhotoWall.astro";
import { photos } from "../data/site-content";

const sortedPhotos = [...photos].sort(
  (a, b) => new Date(b.captureDate).valueOf() - new Date(a.captureDate).valueOf()
);

const categories = [
  { value: "all", label: "All" },
  { value: "past-day", label: "Past day" },
  { value: "china", label: "China" },
  { value: "future", label: "Future" },
];

const seo = {
  title: "攝影作品集｜Lockon 賴世原",
  description:
    "瀏覽 Lockon 賴世原的攝影作品集，收錄旅拍、街景與個人影像創作。",
  canonical: new URL("/photography", Astro.site).toString(),
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: "攝影作品集",
      url: seo.canonical,
      description: seo.description,
      inLanguage: "zh-Hant",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "首頁", item: Astro.site?.toString() },
        { "@type": "ListItem", position: 2, name: "攝影作品集", item: seo.canonical },
      ],
    },
  ],
};
---

<Layout {...seo} schema={schema}>
  <main class="sm:px-[103px]">
    <div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-stretch p-[20px] sm:p-0 gap-6 md:gap-10">
      <nav class="md:min-w-[161px] self-start flex flex-col gap-3" aria-label="作品分類">
        {
          categories.map((item, index) => (
            <button
              class="text-left section-filter-link"
              type="button"
              data-filter-trigger
              data-filter-value={item.value}
              data-default={index === 0 ? "true" : undefined}
            >
              {item.label}
            </button>
          ))
        }
      </nav>
      <div class="flex flex-col flex-1 justify-start md:max-h-[70vh] md:overflow-y-auto md:pr-2 scrollbar-hide gap-6">
        <h1 class="w-full text-center md:text-left text-2xl font-semibold">
          Photography Archive
        </h1>
        <PhotoWall photos={sortedPhotos} />
      </div>
      <h2 class="section-outline-label hidden md:flex items-center justify-center self-start min-w-[100px] min-h-[70vh] pointer-events-none">
        PORTFOLIO
      </h2>
    </div>
  </main>
</Layout>

<script>
  const initFilters = (scope: Document) => {
    const triggers = scope.querySelectorAll<HTMLElement>("[data-filter-trigger]");
    const cards = scope.querySelectorAll<HTMLElement>("figure[data-category]");
    if (!triggers.length || !cards.length) return;

    const applyFilter = (value: string) => {
      cards.forEach((card) => {
        const shouldShow =
          value === "all" || card.dataset.category === value;
        card.classList.toggle("hidden", !shouldShow);
      });
      triggers.forEach((trigger) => {
        trigger.dataset.active = String(trigger.dataset.filterValue === value);
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        applyFilter(trigger.dataset.filterValue ?? "all");
      });
    });

    const defaultTrigger = Array.from(triggers).find((trigger) => trigger.dataset.default === "true");
    applyFilter(defaultTrigger?.dataset.filterValue ?? "all");
  };

  initFilters(document);
</script>

<style is:inline>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
