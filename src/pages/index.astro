---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import avatarImage from "../assets/avatar.webp";
import circleImage from "../assets/circle.webp";
import { photos, posts } from "../data/site-content";

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.publishDate).valueOf() - new Date(a.publishDate).valueOf()
);
const [featuredPost] = sortedPosts.filter((post) => post.featured);
const featuredPhotos = photos.filter((photo) => photo.featured).slice(0, 3);

const seo = {
  title: "Lockon 賴世原｜前端工程師與攝影作品",
  description:
    "Lockon 賴世原的個人網站，收錄前端作品、攝影創作、旅遊紀錄與聯絡資訊。",
  canonical: new URL("/", Astro.site).toString(),
  ogImage: new URL("/avatar.png", Astro.site).toString(),
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${seo.canonical}#website`,
      url: seo.canonical,
      name: "Lockon 賴世原",
      description: seo.description,
      inLanguage: "zh-Hant",
    },
    {
      "@type": "Person",
      "@id": `${seo.canonical}#person`,
      name: "賴世原",
      alternateName: "Lockon",
      url: seo.canonical,
      image: seo.ogImage,
      jobTitle: "Frontend Engineer",
      description: seo.description,
    },
  ],
};
---

<Layout {...seo} schema={schema}>
  <main class="flex flex-col">
    <section class="relative min-h-[65vh] flex items-end">
      <div class="grid lg:grid-cols-[1.3fr_0.7fr] w-full">
        <div class="relative">
          <img
            class="h-full w-full object-cover media-monochrome"
            src={featuredPhotos[0]?.image.src ?? avatarImage.src}
            alt={featuredPhotos[0]?.alt ?? "Lockon 網站首頁主視覺照片"}
            width={1920}
            fetchpriority="high"
            loading="eager"
          />
          <div class="absolute inset-0 bg-black/20"></div>
          <h1 class="font-quattrocento text-[8vw] font-normal leading-tight text-center text-gold-100 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
            <span class="block">Photograph</span>
            <span class="block">What You Love</span>
          </h1>
        </div>
        <div class="bg-black/80 text-custom-beige p-8 md:p-12 flex flex-col justify-end gap-6">
          <p class="uppercase tracking-[0.5em] text-sm text-gold-100">
            Featured Journal
          </p>
          {featuredPost && (
            <>
              <h2 class="text-3xl font-bold">{featuredPost.title}</h2>
              <p class="leading-8">{featuredPost.excerpt}</p>
              <a class="inline-flex items-center gap-4" href={`/journal/${featuredPost.slug}/`}>
                <span>閱讀文章</span>
                <Icon class="!w-3" name="allow" />
              </a>
            </>
          )}
        </div>
      </div>
    </section>
    <section class="flex items-center justify-center p-4 sm:gap-[135px] gap-[30px] flex-wrap">
      <div class="flex flex-col">
        <h2 class="font-normal text-[clamp(20px,5vw,80px)]">Lockon</h2>
        <div class="flex flex-col sm:flex-row">
          <div class="flex flex-col">
            <span>LAI</span>
            <span>SHIH</span>
            <span>YUAN</span>
          </div>
          <div class="flex relative sm:w-[420px] justify-end">
            <img
              class="absolute sm:right-[140px]"
              src={circleImage.src}
              alt=""
              aria-hidden="true"
              width={360}
              loading="lazy"
            />
            <img
              src={avatarImage.src}
              class="w-auto h-auto object-fill"
              alt="Lockon 賴世原的人像照片"
              width={420}
              loading="lazy"
            />
          </div>
        </div>
      </div>
      <div class="flex flex-col w-[360px]">
        <div class="flex gap-6 items-center sm:mb-[108px] mb-[30px]">
          <h2 class="text-4xl font-black tracking-[.8rem] font-sans text-nowrap">
            賴世原
          </h2>
          <span class="text-sm font-normal">Photographer</span>
        </div>
        <div class="mb-[45px]">
          <div class="border border-slate-950"></div>
        </div>
        <p>
          這是 Lockon 的個人攝影與旅遊誌網站。作品集收錄旅拍與城市影像，
          Journal 則整理旅行途中留下的觀察、文字與片刻。
        </p>
      </div>
    </section>
  </main>
</Layout>
